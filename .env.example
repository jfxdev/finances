# Copie para .env e substitua todos os placeholders. Não faça commit de .env.
# Use uma senha URL-safe (hexadecimal) para facilitar DATABASE_URL.
POSTGRES_PASSWORD=replace-with-random-hex-password
DATABASE_URL=postgres://finances:replace-with-random-hex-password@localhost:5432/finances
# Gere 32 bytes aleatórios em base64 para cada versão. Não reutilize SETUP_TOKEN.
MASTER_KEYS={"v1":"replace-with-32-byte-base64-key"}
ACTIVE_MASTER_KEY=v1
SETUP_TOKEN=replace-with-at-least-24-random-characters
PUBLIC_URL=https://finances.example.com
NODE_ENV=production
APP_PORT=3000
